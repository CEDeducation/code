# Server-side only. Add these in Vercel > Project > Settings > Environment Variables.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
# Tutor remains OFF by default. Set 1 only in a controlled personal deployment.
ENABLE_AI_TUTOR=0
# Set a long random secret on the server; enter it in the lesson tutor access field.
TUTOR_ACCESS_CODE=replace_with_a_long_random_private_secret
